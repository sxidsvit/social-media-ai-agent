# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database

# Inngest Background Jobs & Cron Scheduler
# Local Dev: Run `npm run inngest:dev` (no keys required locally)
# Production: Set Event Key & Signing Key from Inngest Dashboard (https://app.inngest.com)
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here

# InsForge (put real values in .env.local)
NEXT_PUBLIC_INSFORGE_URL=https://your-appkey.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your_insforge_anon_key

# OpenAI (agents, screenshot uploads, fallback image generation). Server only.
OPENAI_API_KEY=your_openai_api_key
# OpenAI image model, used only when IMAGE_PROVIDER=openai (optional)
OPENAI_IMAGE_MODEL=gpt-image-1

# Gemini: the Creator Agent's default image generator. Server only.
GEMINI_API_KEY=your_gemini_api_key
# Gemini image model (optional)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# E2B desktop sandboxes: one per campaign, shared by its agents. Server only.
E2B_API_KEY=your_e2b_api_key

# ImageKit: permanent URLs for agent files and AI image transformations (background removal,
# prompt edits, upscale, generative fill). Server only.
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# Creator Agent's image generator: gemini (default, ImageKit as fallback), imagekit (Gemini as fallback) or openai
IMAGE_PROVIDER=gemini

# Encrypts each user's Blotato API key before it's stored (AES-256-GCM). 32 bytes, base64:
# openssl rand -base64 32. Server only. Changing it makes stored keys unreadable (users reconnect).
INTEGRATIONS_ENCRYPTION_KEY=your_32_byte_base64_key
